# Pehchaan web app build settings (read in src/app/flags.ts and src/app/config.ts). Copy to .env.local.
# Vite bakes these in at build time: a change needs a new build.

# ─── What is simulated (backend spec FC-1) ─────────────────────────────────────
# VITE_SIMULATION is the default for all three. Never show judges a build where any of them is true.
VITE_SIMULATION=true
# VITE_SIM_RELAY=false      # talk to the real relay (VITE_RELAY_URL)
# VITE_SIM_KEY=false        # use the phone's real passkey
# VITE_SIM_VERIFIER=false   # verify against VITE_ORIGIN / VITE_RP_ID instead of this page's own address

# ─── Screens ───────────────────────────────────────────────────────────────────
VITE_ENABLE_LAB=true
VITE_ENABLE_GUARD=true
VITE_ENABLE_EXTRAS=false

# ─── Where it runs (backend spec 5.3, 18.7) ────────────────────────────────────
# Without these, everything points at this page's own origin and the relay at /relay on it (dev proxy).
# VITE_ENV=production
# VITE_ORIGIN=https://app.yourdomain.in
# VITE_RP_ID=app.yourdomain.in          # the passkey rpId: NEVER change it after launch
# VITE_RELAY_URL=wss://relay.yourdomain.in/v1/ws
# VITE_RELAY_HTTP=https://relay.yourdomain.in
# Web Push (backend spec 11): the relay's public VAPID key and its ID, from `pnpm tsx infra/scripts/vapid-keys.ts`.
# Without a key, alerts are off: A8 and Settings → Alerts say "Not available here".
# VITE_VAPID_PUBLIC_KEY=
# VITE_VAPID_KEY_ID=v1
# VITE_SENTRY_DSN=
# The grievance contact on Settings → Privacy notice (DPDP, backend spec 17.2).
# VITE_PRIVACY_CONTACT=privacy@yourdomain.in
