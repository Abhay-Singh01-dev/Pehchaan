# Local development settings for `pnpm dev` (spec 18.12). Nothing here is a secret: the database password is
# the throwaway one from infra/compose/docker-compose.dev.yml, bound to 127.0.0.1 only.
# The app runs on http://localhost:5180 and Vite proxies /relay to this relay, so the browser sees one origin:
# RELAY_HOST must be that origin's host, because the signed login message includes it (7.3).
ENV_NAME=development
PORT=8080
METRICS_PORT=9091
BIND_HOST=127.0.0.1
RELAY_HOST=localhost:5180
PUBLIC_ORIGINS=http://localhost:5180
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://pehchaan:pehchaan-dev@127.0.0.1:5432/pehchaan
LOG_LEVEL=info
