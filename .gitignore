# Dependencies and build output
node_modules
dist
dev-dist
build
# …but apps/web/build is source: the Vite plugin that writes the production CSP (apps/web/vite.config.ts).
!apps/web/build/
coverage
.turbo
.vite
*.tsbuildinfo

# Test output
test-results
playwright-report
blob-report
apps/*/test-results
.artifacts

# Environment and secrets (infra/vm/env.example and apps/*/.env.example are the committed templates)
.env
.env.*
!.env.example
!**/.env.example
# The relay's local-development settings hold no secrets (spec 18.12), so `pnpm dev` works after a clone.
!apps/relay/.env.development
*.pem
*.key
age-key.txt

# Local tooling
.venv
.DS_Store
Thumbs.db
*.log
.claude/.gate-blocks
.claude/settings.local.json
