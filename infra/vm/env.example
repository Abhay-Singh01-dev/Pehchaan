# /opt/pehchaan/.env on each VM (spec 18.7). NAMES ONLY: copy to .env (mode 600, owner deploy), fill in, never commit.
# Generate every password and key with `openssl rand -hex 32` (hex keeps the database URLs valid).

# ─── Where and what ─────────────────────────────────────────────────────────
ENV_NAME=production
PORT=8080
METRICS_PORT=9091
RELAY_HOST=relay.yourdomain.in
RELAY_UPSTREAMS="relay-a:8080 relay-b:8080"
COMPOSE_PROFILES=ha
# Empty on the VMs; `local_certs` only on a local test stack.
CADDY_LOCAL_CERTS=
CADDY_EMAIL=ops@yourdomain.in
# The image registry (lower case), e.g. ghcr.io/<org>. RELAY_TAG is written by deploy.sh.
IMAGE_REGISTRY=ghcr.io/<org>
RELAY_TAG=
PUBLIC_ORIGINS=https://app.yourdomain.in
TRUST_PROXY=172.30.0.2/32
MIN_CLIENT_VERSION=1.0.0
MAX_SOCKETS=15000
DRAIN_TIMEOUT_MS=20000
RATE_LIMIT_PROFILE=standard
LOG_LEVEL=info
RELEASE=

# ─── Stores (secrets) ───────────────────────────────────────────────────────
VALKEY_PASSWORD=
POSTGRES_PASSWORD=
REDIS_URL=redis://:<VALKEY_PASSWORD>@valkey:6379
DATABASE_URL=postgres://pehchaan:<POSTGRES_PASSWORD>@postgres:5432/pehchaan

# ─── Keys (secrets: AUDIT_KEY, IP_HASH_KEY, VAPID_PRIVATE_KEY, LAB_PASSWORD_HASH) ───
AUDIT_KEY=
IP_HASH_KEY=
# From `pnpm tsx infra/scripts/vapid-keys.ts <key-id>`; one pair per environment (11.1).
VAPID_KEY_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@yourdomain.in
E2E_REQUIRED=false
LAB_ENABLED=false
# From `pnpm tsx infra/scripts/lab-password-hash.ts`, in SINGLE quotes (it contains $). Only when LAB_ENABLED=true.
LAB_PASSWORD_HASH=''
SENTRY_DSN=

# ─── Backups (18.10): age PUBLIC key only; the private key stays offline with two teammates ───
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=backup:pehchaan-backups
# rclone remote "backup" (Backblaze B2 or Cloudflare R2), e.g. for R2:
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Cloudflare
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_BACKUP_ENDPOINT=

# ─── Grafana Cloud (19): Alloy's push endpoints and token (secret) ───
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_TOKEN=
