# syntax=docker/dockerfile:1.7
# The relay image (spec 18.5): built for linux/arm64 (the Oracle VMs) and linux/amd64 from the same file.
# The final image holds only the built relay (dist/, lua/, migrations/) and its production dependencies, and runs
# as the non-root `node` user. Base images are pinned by digest; every build is scanned with Trivy (deploy-relay.yml).

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS build
WORKDIR /repo
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY apps/relay ./apps/relay
RUN pnpm install --frozen-lockfile --filter @pehchaan/relay...
RUN pnpm turbo run build --filter @pehchaan/relay
# The workspace packages are bundled into dist/ by the build, so `deploy` only has to install npm dependencies.
# `--legacy` does that without `inject-workspace-packages`, which would change how packages link in development.
RUN pnpm --filter @pehchaan/relay deploy --prod --legacy /out

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
WORKDIR /app
COPY --from=build --chown=node:node /out/package.json ./
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /out/dist ./dist
COPY --from=build --chown=node:node /out/lua ./lua
COPY --from=build --chown=node:node /out/migrations ./migrations
# The retention rules (15.3), shared with the backup job; `node dist/admin.js retention` reads them from /app.
COPY --chown=node:node infra/backup/retention.sql ./retention.sql
ENV NODE_ENV=production
USER node
EXPOSE 8080 9091
CMD ["node", "dist/main.js"]
