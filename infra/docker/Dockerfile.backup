# syntax=docker/dockerfile:1.7
# The backup image (spec 18.10): FROM postgres:16 so pg_dump matches the server, plus age (encryption), rclone
# (upload to the off-provider bucket) and supercronic (the nightly schedule). Multi-arch like the relay image.
FROM postgres:16@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54

ARG TARGETARCH
ARG SUPERCRONIC_VERSION=v0.2.49

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    age=1.2.1-1+b5 \
    rclone=1.60.1+dfsg-4 \
    ca-certificates=20250419 \
    curl=8.14.1-2+deb13u5 \
  && rm -rf /var/lib/apt/lists/*

# supercronic, checked against the release's published binaries (pinned SHA-256 per architecture).
RUN case "${TARGETARCH}" in \
      amd64) sha=a53ae236602c7338aba3fbaff40bda6300eae3b9fedb8261eb06cfe3724430c1 ;; \
      arm64) sha=02aa0cb229ba09050cba6638059dadb9eedc2276632ea43d6a57a2f8c1629dd5 ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
  && curl -fsSLo /usr/local/bin/supercronic \
    "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-${TARGETARCH}" \
  && echo "${sha}  /usr/local/bin/supercronic" | sha256sum -c - \
  && chmod +x /usr/local/bin/supercronic

COPY --chmod=755 infra/backup/backup.sh infra/backup/restore.sh /opt/backup/
COPY infra/backup/retention.sql infra/backup/crontab /opt/backup/
RUN mkdir -p /metrics && chown postgres:postgres /metrics

USER postgres
ENTRYPOINT []
CMD ["supercronic", "/opt/backup/crontab"]
