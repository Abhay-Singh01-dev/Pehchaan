{
  "name": "pehchaan",
  "private": true,
  "type": "module",
  "description": "Pehchaan: two-factor authentication for humans. The app, the relay, and their shared security core.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@pehchaan/relay --filter=@pehchaan/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:integration": "pnpm --filter @pehchaan/relay test:integration",
    "test:e2e": "pnpm --filter @pehchaan/tests e2e && pnpm --filter @pehchaan/web e2e",
    "test:e2e:real": "pnpm --filter @pehchaan/tests e2e",
    "test:ops": "pnpm --filter @pehchaan/tests exec vitest run -c ops/vitest.config.ts",
    "test:load:short": "pnpm --filter @pehchaan/tests exec vitest run -c load/vitest.config.ts",
    "test:chaos": "pnpm --filter @pehchaan/tests exec vitest run -c chaos/vitest.config.ts",
    "depcruise": "depcruise apps/relay/src apps/web/src apps/canary/src apps/loadgen/src packages/crypto/src packages/protocol/src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "banned-words": "node scripts/check-banned-words.mjs",
    "check-matrix": "node scripts/check-test-matrix.mjs",
    "check-migrations": "node scripts/check-migrations.mjs",
    "test:security": "node scripts/test-security.mjs",
    "db:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/compose/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "hash-wasm": "4.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
